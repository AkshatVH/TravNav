<mujoco model="diffbot">
  <compiler angle="degree"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
  </visual>
  <asset>
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.55 0.7 0.95" rgb2="0.95 0.97 1" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.78 0.78 0.78" rgb2="0.5 0.5 0.5" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="20 4" reflectance="0.05"/>
  </asset>
  <worldbody>
    <light pos="7 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="12 3 0.1" pos="7 0 0" material="grid"/>

    <geom name="wall_back" type="box" size="0.1 0.9 0.4" pos="-0.6 0 0.4" rgba="0.6 0.6 0.6 1"/>
    <geom name="wall_end" type="box" size="0.1 0.9 0.4" pos="15.1 0 0.4" rgba="0.6 0.6 0.6 1"/>

    <geom name="wl_1" type="box" size="1.5 0.1 0.4" pos="0.9 0.9 0.4" rgba="0.85 0.35 0.3 1"/>
    <geom name="wl_2" type="box" size="1.5 0.1 0.4" pos="3.9 0.9 0.4" rgba="0.3 0.45 0.85 1"/>
    <geom name="wl_3" type="box" size="1.5 0.1 0.4" pos="6.9 0.9 0.4" rgba="0.9 0.8 0.3 1"/>
    <geom name="wl_4" type="box" size="1.5 0.1 0.4" pos="9.9 0.9 0.4" rgba="0.3 0.7 0.4 1"/>
    <geom name="wl_5" type="box" size="1.5 0.1 0.4" pos="12.9 0.9 0.4" rgba="0.7 0.4 0.8 1"/>

    <geom name="wr_1" type="box" size="1.5 0.1 0.4" pos="0.9 -0.9 0.4" rgba="0.3 0.7 0.4 1"/>
    <geom name="wr_2" type="box" size="1.5 0.1 0.4" pos="3.9 -0.9 0.4" rgba="0.9 0.8 0.3 1"/>
    <geom name="wr_3" type="box" size="1.5 0.1 0.4" pos="6.9 -0.9 0.4" rgba="0.85 0.35 0.3 1"/>
    <geom name="wr_4" type="box" size="1.5 0.1 0.4" pos="9.9 -0.9 0.4" rgba="0.7 0.4 0.8 1"/>
    <geom name="wr_5" type="box" size="1.5 0.1 0.4" pos="12.9 -0.9 0.4" rgba="0.3 0.45 0.85 1"/>

    <geom name="obs_1" type="box" size="0.25 0.35 0.3" pos="3.0 0.4 0.3" rgba="0.8 0.2 0.6 1"/>
    <geom name="obs_2" type="cylinder" size="0.3 0.4" pos="5.5 -0.45 0.4" rgba="0.9 0.5 0.1 1"/>
    <geom name="obs_3" type="box" size="0.25 0.35 0.3" pos="8.0 0.4 0.3" rgba="0.2 0.8 0.8 1"/>
    <geom name="obs_4" type="cylinder" size="0.3 0.4" pos="10.5 -0.45 0.4" rgba="0.2 0.2 0.2 1"/>
    <geom name="obs_5" type="box" size="0.25 0.35 0.3" pos="12.5 0.4 0.3" rgba="0.95 0.95 0.2 1"/>

    <geom name="goal_marker" type="box" size="0.05 0.7 0.001" pos="14.0 0 0.002" rgba="0.1 0.9 0.1 1" contype="0" conaffinity="0"/>

    <body name="base" pos="0.3 0 0.05">
      <freejoint name="root"/>
      <geom name="chassis" type="box" size="0.15 0.1 0.03" pos="0 0 0.01" mass="3" rgba="0.2 0.3 0.8 1"/>
      <geom name="caster_front" type="sphere" size="0.02" pos="0.12 0 -0.03" mass="0.05" friction="0.001 0.001 0.001" priority="1" condim="1"/>
      <geom name="caster_rear" type="sphere" size="0.02" pos="-0.12 0 -0.03" mass="0.05" friction="0.001 0.001 0.001" priority="1" condim="1"/>
      <camera name="front" pos="0.15 0 0.2" xyaxes="0 -1 0 0 0 1" fovy="75"/>
      <body name="left_wheel" pos="0 0.12 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom type="cylinder" size="0.05 0.02" euler="90 0 0" mass="0.3" friction="1.5 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.12 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.001"/>
        <geom type="cylinder" size="0.05 0.02" euler="90 0 0" mass="0.3" friction="1.5 0.005 0.0001" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>

    <camera name="topdown" pos="7 0 12" xyaxes="1 0 0 0 1 0" fovy="55"/>
  </worldbody>
  <actuator>
    <velocity name="left_motor" joint="left_wheel_joint" kv="0.5" ctrlrange="-30 30" forcerange="-2 2"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="0.5" ctrlrange="-30 30" forcerange="-2 2"/>
  </actuator>
</mujoco>